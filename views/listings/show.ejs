 <% layout("/layouts/boilerplate") -%>
 <div class="row mt-3">
    <div class="col-8 offset-2">
        <div class="card col-6 offset-2 show-card" style="width: 18rem;">
    <h3>Listings details</h3>
  <img src=" <%= listing.image.url %>" class="card-img-top show-img" alt="listings_image">
  <div class="card-body">
    <p class="card-text"> 
        <b><%= listing.title %></p></b> <br>
        <br>
        <%=listing.description %> <br>
        <br>
         &#8377;<%= listing.price?.toLocaleString("en-IN") ?? "N/A" %> <br>
         <br>
         <%=listing.location %> <br>
         <br>
         <%=listing.country %>
  </div>
</div>
  </div>


  <div class="btns" >
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-success col-1 offset-2" >Edit </a>
 <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
    <button class="btn btn-danger  offset-4" >Delete </button>
    <br>
    
</form>
   </div>
    </div>
 